generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model School {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  caption      String
  address      String
  phone        String
  logoUrl      String
  signatureUrl String
  classes      Class[]
  students     Student[]
  users        User[]
  idCardLayout       Int?      @default(1)
  idCardTheme        String?
  customFieldsConfig Json?
  idCardLayoutConfig Json?
  customValues       Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Student {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId          String   @db.ObjectId
  school            School   @relation(fields: [schoolId], references: [id])
  name              String
  camSno            String
  fatherName        String
  fatherPhone       String
  address           String
  class             Class    @relation(fields: [classId], references: [id])
  classId           String   @db.ObjectId
  profilePictureUrl String
  customValues      Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Class {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  schoolId  String    @db.ObjectId
  school    School    @relation(fields: [schoolId], references: [id])
  students  Student[]
  customValues Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  username     String   @unique
  password     String
  role         String // "admin" | "school_admin" | "user"
  schoolId     String?  @db.ObjectId
  school       School?  @relation(fields: [schoolId], references: [id])
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String
  username   String
  role       String
  action     String   // "LOGIN" | "LOGOUT"
  schoolId   String?  @db.ObjectId
  schoolName String?
  timestamp  DateTime @default(now())
}

